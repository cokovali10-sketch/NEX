# mathx - small math helpers for NEX.
# Use: use mathx from "mathx.nex"  then  mathx.square(9)
pub fn square(x: i64) -> i64:
    return x * x

pub fn cube(x: i64) -> i64:
    return x * x * x

pub fn clamp(v: i64, lo: i64, hi: i64) -> i64:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

pub fn gcd(a: i64, b: i64) -> i64:
    var x = a
    var y = b
    while y != 0:
        var t = x % y
        x = y
        y = t
    return x

pub fn max_of(a: i64, b: i64) -> i64:
    if a > b:
        return a
    return b

pub fn min_of(a: i64, b: i64) -> i64:
    if a < b:
        return a
    return b

pub fn abs(x: i64) -> i64:
    if x < 0:
        return 0 - x
    return x

pub fn sign(x: i64) -> i64:
    if x > 0:
        return 1
    if x < 0:
        return 0 - 1
    return 0

pub fn pow(base: i64, exp: i64) -> i64:
    var result = 1
    var e = exp
    while e > 0:
        result *= base
        e -= 1
    return result

# Sum of 1..n (inclusive); 0 for n <= 0.
pub fn sum_to(n: i64) -> i64:
    return n * (n + 1) / 2

pub fn is_prime(n: i64) -> bool:
    if n < 2:
        return false
    var i = 2
    while i * i <= n:
        if n % i == 0:
            return false
        i += 1
    return true

pub fn fib(n: i64) -> i64:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        var t = a + b
        a = b
        b = t
        i += 1
    return a

# Count how many times `digit` appears in the decimal form of `n`.
pub fn count_digit(n: i64, digit: i64) -> i64:
    var x = abs(n)
    if x == 0:
        if digit == 0:
            return 1
        return 0
    var count = 0
    while x > 0:
        if x % 10 == digit:
            count += 1
        x /= 10
    return count

pub fn min3(a: i64, b: i64, c: i64) -> i64:
    var m = a
    if b < m:
        m = b
    if c < m:
        m = c
    return m

pub fn max3(a: i64, b: i64, c: i64) -> i64:
    var m = a
    if b > m:
        m = b
    if c > m:
        m = c
    return m

pub fn is_even(n: i64) -> bool:
    return n % 2 == 0

pub fn is_odd(n: i64) -> bool:
    return n % 2 != 0

# Sum of the integers in [start, end).
pub fn sum_range(start: i64, end: i64) -> i64:
    var sum = 0
    var i = start
    while i < end:
        sum += i
        i += 1
    return sum

pub fn mean(a: i64, b: i64) -> i64:
    return (a + b) / 2

pub fn count_digits(n: i64) -> i64:
    var x = abs(n)
    if x == 0:
        return 1
    var count = 0
    while x > 0:
        count += 1
        x /= 10
    return count

# Linear interpolation between a and b; t is a percentage in [0, 100].
pub fn lerp(a: i64, b: i64, t: i64) -> i64:
    return a + (b - a) * t / 100
