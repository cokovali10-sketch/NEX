# mathx - small math helpers for NEX.
# Use: use mathx from "mathx.nex"  then  mathx.square(9)

pub fn square(x: i64) -> i64:
    return x * x

pub fn cube(x: i64) -> i64:
    return x * x * x

pub fn clamp(v: i64, lo: i64, hi: i64) -> i64:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

pub fn gcd(a: i64, b: i64) -> i64:
    var x = a
    var y = b
    while y != 0:
        var t = x % y
        x = y
        y = t
    return x

pub fn max_of(a: i64, b: i64) -> i64:
    if a > b:
        return a
    return b

pub fn min_of(a: i64, b: i64) -> i64:
    if a < b:
        return a
    return b