# clix - helpers for the common --flag and --option value command-line style.
pub fn has_flag(name: string) -> bool:
    var i = 0
    while i < args_count():
        if arg_at(i) == name:
            return true
        i += 1
    return false

pub fn option(name: string, fallback: string) -> string:
    var i = 0
    while i < args_count():
        let current = arg_at(i)
        if current == name:
            if i + 1 < args_count():
                let value = arg_at(i + 1)
                if not str_starts_with(value, "--"):
                    return value
            return fallback
        let equals = str_index_of(current, "=")
        if equals >= 0 and str_substring(current, 0, equals) == name:
            return str_substring(current, equals + 1, len(current))
        i += 1
    return fallback

pub fn require_option(name: string, message: string) -> string:
    let value = option(name, "")
    if len(value) == 0:
        log_error(message)
        exit(2)
    return value

pub fn print_usage(program: string, usage: string):
    println(concat("Usage: ", concat(program, concat(" ", usage))))
