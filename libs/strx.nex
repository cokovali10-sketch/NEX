# strx - small string helpers for NEX.
# Use: use strx from "strx.nex"  then  strx.repeat("ab", 3)

pub fn repeat(s: string, n: i64) -> string:
    var out = ""
    var i = 0
    while i < n:
        out = out + s
        i = i + 1
    return out

pub fn shout(s: string) -> string:
    return str_upper(s) + "!"

pub fn surround(s: string, left: string, right: string) -> string:
    return left + s + right

pub fn reverse(s: string) -> string:
    var out = ""
    var i = len(s) - 1
    while i >= 0:
        out = out + char_at(s, i)
        i = i - 1
    return out

# Number of occurrences of `ch` (a one-character string) in `s`.
pub fn count_char(s: string, ch: string) -> i64:
    var count = 0
    var i = 0
    while i < len(s):
        if char_at(s, i) == ch:
            count = count + 1
        i = i + 1
    return count

pub fn is_empty(s: string) -> bool:
    return len(s) == 0

pub fn has_prefix(s: string, prefix: string) -> bool:
    if len(prefix) > len(s):
        return false
    return str_substring(s, 0, len(prefix)) == prefix

pub fn has_suffix(s: string, suffix: string) -> bool:
    if len(suffix) > len(s):
        return false
    return str_substring(s, len(s) - len(suffix), len(suffix)) == suffix

# Capitalise the first character, leave the rest as-is.
pub fn capitalize(s: string) -> string:
    if len(s) == 0:
        return s
    return str_upper(str_substring(s, 0, 1)) + str_substring(s, 1, len(s))

pub fn str_pad_left(s: string, width: i64, ch: string) -> string:
    var out = s
    while len(out) < width:
        out = ch + out
    return out

pub fn str_pad_right(s: string, width: i64, ch: string) -> string:
    var out = s
    while len(out) < width:
        out = out + ch
    return out

# Replace every occurrence of `old` with `new`.
pub fn str_replace(s: string, old: string, new: string) -> string:
    var out = ""
    var i = 0
    while i < len(s):
        if len(old) > 0 && i + len(old) <= len(s) && str_substring(s, i, i + len(old)) == old:
            out = out + new
            i = i + len(old)
        else:
            out = out + char_at(s, i)
            i = i + 1
    return out

# Count non-overlapping occurrences of `sub` in `s`.
pub fn str_count(s: string, sub: string) -> i64:
    if len(sub) == 0:
        return 0
    var count = 0
    var i = 0
    while i + len(sub) <= len(s):
        if str_substring(s, i, i + len(sub)) == sub:
            count = count + 1
            i = i + len(sub)
        else:
            i = i + 1
    return count

pub fn is_alpha(s: string) -> bool:
    if len(s) != 1:
        return false
    return str_contains("abcdefghijklmnopqrstuvwxyz", str_lower(s))

pub fn is_digit(s: string) -> bool:
    if len(s) != 1:
        return false
    return str_contains("0123456789", s)

# Sum of the character codes of every character in `s`.
pub fn ascii_sum(s: string) -> i64:
    var sum = 0
    var i = 0
    while i < len(s):
        sum = sum + char_code(char_at(s, i))
        i = i + 1
    return sum