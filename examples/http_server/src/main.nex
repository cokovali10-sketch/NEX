var router = 0
var pool = 0

fn json(body: string) -> string:
    return http_response("200 OK", "application/json", body)

fn dispatch(request: string) -> string:
    var route = router_match(router, http_method(request), http_path(request))

    if route == 1:
        return json("{\"hello\": \"world\"}")

    if route == 2:
        return json(concat("{\"id\": ", concat(router_param(router, "id"), "}")))

    if route == 3:
        return http_response("200 OK", "text/plain; charset=utf-8", "created")

    if route == -1:
        return http_response("405 Method Not Allowed", "text/plain", "method not allowed")

    return http_response("404 Not Found", "text/plain", "not found")

fn serve(client: i64):
    var request = tcp_read(client, 16384)
    if len(request) == 0:
        tcp_close(client)
        return

    var response = dispatch(request)
    tcp_write(client, response, len(response))
    tcp_close(client)

fn main():
    router = router_new()
    router_add(router, "GET", "/")
    router_add(router, "GET", "/user/:id")
    router_add(router, "POST", "/items")

    var server = tcp_listen(8080, 128)
    if server < 0:
        print("failed to listen on 8080")
        return

    pool = pool_new(8, 256)
    if pool == 0:
        print("failed to create the worker pool")
        return

    print("NEX server on http://127.0.0.1:8080")

    while true:
        var client = tcp_accept(server)
        if client < 0:
            continue
        pool_submit(pool, "serve", client)