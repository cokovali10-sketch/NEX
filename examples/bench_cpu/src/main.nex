# CPU-bound workloads, so the comparison is about generated code, not sockets.
# Loop bodies carry a data dependency, so the optimizer cannot close-form them.

const ITER = 20000000

fn lcg_loop(seed: i64) -> i64:
    var x = seed
    var i = 0
    while i < ITER:
        x = (x * 1103515245 + 12345) % 2147483648
        i = i + 1
    return x

fn math_loop(seed: i64) -> f64:
    var total = 0.0
    var i = 1.0
    var limit = 5000000.0
    while i < limit:
        total = total + sqrt(i)
        i = i + 1.0
    return total

fn string_loop() -> string:
    var out = ""
    var i = 0
    while i < 50000:
        out = concat(out, "x")
        i = i + 1
    return out

fn main():
    var seed = now_ms()

    var start = now_ms()
    var a = lcg_loop(seed)
    var mid = now_ms()
    var b = math_loop(seed)
    var late = now_ms()
    var c = string_loop()
    var end = now_ms()

    print("lcg_loop: ")
    println(mid - start)
    print("math_loop: ")
    println(late - mid)
    print("string_loop: ")
    println(end - late)
    print("checksum: ")
    println(a + len(c))