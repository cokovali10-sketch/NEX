fn main():
    let a = [1, 2, 3]
    print("a = ")
    print(a[0])
    print(a[1])
    println(a[2])

    var b = [10, 20, 30]
    b[1] = 99
    print("b = ")
    print(b[0])
    print(b[1])
    println(b[2])

    let c = b
    b[0] = 7
    print("c[0] (unchanged) = ")
    println(c[0])
    print("b[0] (changed) = ")
    println(b[0])
