fn add(a: i64, b: i64) -> i64:
    return a + b

fn classify(x: i64) -> i64:
    if x < 0:
        return 0
    elif x == 0:
        return 1
    else:
        return 2

fn main():
    var total = 0
    var i = 1
    while i <= 5:
        total = total + i
        i = i + 1

    print("total = ")
    println(total)
    print("add(2, 3) = ")
    println(add(2, 3))
    print("classify(-1) = ")
    println(classify(-1))
    print("classify(0) = ")
    println(classify(0))
    print("classify(7) = ")
    println(classify(7))
